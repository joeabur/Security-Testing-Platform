# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# Defaults below are for local development only — see
# docs/BUILD_SPEC.md §2 and §5.2 before pointing this at anything but the
# bundled demo lab.

# --- PostgreSQL (used by the `postgres` service and the backend/worker) ---
POSTGRES_USER=kervy
POSTGRES_PASSWORD=kervy-dev-only-change-me
POSTGRES_DB=kervy

# --- Backend / worker ---
# Built from the POSTGRES_* values above when running via docker-compose;
# override directly if you point the backend at a different database.
DATABASE_URL=postgresql+asyncpg://kervy:kervy-dev-only-change-me@postgres:5432/kervy  # pragma: allowlist secret
REDIS_URL=redis://redis:6379/0

# Where evidence bundles and their hash-chained manifests are written
# (docs/BUILD_SPEC.md §13). A path on the backend and worker, not a URL:
# evidence is never published, and there is no unauthenticated download for
# it. Put this on a volume with the access controls you would give a log of
# production traffic. In docker-compose this is a named volume shared by the
# backend and the worker; the worker writes and the API reads.
EVIDENCE_ROOT=/var/lib/kervy/evidence

# Encryption at rest for evidence bundles (§13) is optional — absent, a
# bundle is protected only by filesystem permissions and the redaction that
# ran before it was written, same as always. Set this to turn it on: a
# base64-encoded 32-byte (AES-256) key, generated with
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# One static key, no rotation tooling — set before a deployment starts
# collecting evidence, not switched on partway through (app/core/evidence/store.py).
# KERVY_EVIDENCE_ENCRYPTION_KEY=

# Workflow automation (pentest-module Phase 8): unlike the evidence key
# above, this one is NOT optional-encryption — a webhook secret must never
# sit in Postgres in cleartext, so a workflow's inbound webhook cannot be
# enabled at all until this is set. Same base64-encoded 32-byte (AES-256)
# key format and generation command as KERVY_EVIDENCE_ENCRYPTION_KEY, but a
# separate key: rotating one must never silently invalidate the other.
# KERVY_WEBHOOK_SECRET_ENCRYPTION_KEY=

# Third-party plugins (docs/BUILD_SPEC.md §16, docs/plugin-development.md).
# Discovery is OFF unless this points at a file naming the packages allowed to
# load — `pip install` must not be what decides which code runs inside the
# scope engine's process. Plugins are not sandboxed: they run in the worker.
# KERVY_NO_PLUGINS=1 turns discovery off whatever else is configured.
# PLUGINS_CONFIG=/etc/kervy/plugins.yaml
# KERVY_NO_PLUGINS=0

# Refuses to start with this default when ENVIRONMENT=production
# (app/core/config.py) — generate a real secret before any non-local use:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-development-secret-change-me
ENVIRONMENT=local

# Comma-free JSON array of browser origins allowed to call the API with
# credentials.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Set to true once the API is served over HTTPS — the session cookie is
# marked httpOnly and SameSite=Lax always, but Secure is opt-in here so
# local HTTP development keeps working.
SESSION_COOKIE_SECURE=false

# --- Frontend ---
# Reached from inside the Docker network (server components / route handlers).
BACKEND_INTERNAL_URL=http://backend:8000/api/v1
# Reached from the browser — must be resolvable from the developer's machine.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- AI intelligence layer (entirely optional) ---------------------------
# Leave these unset and the platform behaves identically: scanning, scoring,
# reporting and the CI gate all work with no AI provider configured.
# AI_API_KEY_ENV_VAR names the environment variable holding the key — the key
# itself is never stored in configuration, the database, or a log.
# AI_PROVIDER=openai_compatible
# AI_ENDPOINT=https://api.example.com/v1/chat/completions
# AI_MODEL=your-model-id
# AI_API_KEY_ENV_VAR=KERVY_AI_API_KEY
# AI_AUTONOMY_MODE=ASSIST   # OFF | ASSIST | RECOMMEND | APPROVAL_REQUIRED | EXECUTE

# --- Outbound notifications (entirely optional) --------------------------
# See docs/integrations.md. Two rules explain the shape of everything here:
#
#  1. A channel's credential is never stored. The database holds the *name* of
#     an environment variable; the value lives here (or in your secret store)
#     and is read at delivery time. A Slack incoming webhook URL is itself a
#     credential, because the token is its path — hence the whole URL by
#     reference.
#  2. Adding a brand-new outbound destination is an operator decision, not a
#     database row. Vendor kinds are pinned to vendor hosts in code; a generic
#     webhook or an SMTP relay must be listed below before an organization
#     admin can point a channel at it.
#
# KERVY_NOTIFY_ALLOWED_WEBHOOK_HOSTS='["siem.internal.example"]'
# KERVY_NOTIFY_ALLOWED_SMTP_HOSTS='["smtp.example.com"]'
#
# --- Exploitation tier (Pentest module Phase 12) --------------------------
# The specific nmap NSE script names an exploitation-fire request may name.
# Empty by default: nothing is fireable until an operator has personally
# reviewed and named scripts here — this is your own call, not the
# platform's, and it is one of three independent gates (the other two are
# the target's own asset_scope.approved_modules and a live
# ExploitationAuthorization naming the same scripts) that must all agree
# before a script actually runs. Never list a whole category name here
# (exploit/brute/dos/intrusive) — the platform only accepts individually
# named scripts.
# KERVY_EXPLOITATION_ALLOWED_NSE_SCRIPTS='[]'
#
# Used to build links back into the platform in a notification. Leave it unset
# and no link is rendered — a broken link in an alert teaches readers to ignore
# alerts.
# KERVY_PUBLIC_BASE_URL=https://kervy.example.com
#
# The variables a channel would reference. Names are yours to choose; these
# match the examples in docs/integrations.md.
# KERVY_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# KERVY_TEAMS_WEBHOOK=https://example.webhook.office.com/webhookb2/...
# KERVY_WEBHOOK_SIGNING_SECRET=  # HMAC-SHA256 secret for a generic webhook
# KERVY_SMTP_PASSWORD=

# --- Code host connections (entirely optional) ---------------------------
# See docs/pull-requests.md. github.com's API host is pinned in code, so only a
# self-hosted GitHub Enterprise install needs sanctioning here. As with the
# notification lists, this is an operator decision held in the environment, not
# a row an organization admin can add.
# KERVY_VCS_ALLOWED_HOSTS='["git.internal.example"]'
#
# The variable a connection would reference. Name is yours to choose. The token
# needs `checks:write` on the repositories it will post to, and `pull_requests:
# read` to read the diff — nothing more: Kervy never pushes, merges or edits.
# KERVY_GITHUB_TOKEN=

# --- Social OAuth login (entirely optional) -------------------------------
# Leave a provider's client id unset and its login button never appears.
# The client *secret* is never a value here — only the name of the
# environment variable holding it, read fresh at call time.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET_ENV_VAR=KERVY_GOOGLE_OAUTH_SECRET
# KERVY_GOOGLE_OAUTH_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET_ENV_VAR=KERVY_GITHUB_OAUTH_SECRET
# KERVY_GITHUB_OAUTH_SECRET=
#
# This backend's own externally-reachable origin — where a provider redirects
# back to. Required for either provider to work. Distinct from
# KERVY_PUBLIC_BASE_URL above, which is the frontend's.
# KERVY_OAUTH_CALLBACK_BASE_URL=https://api.kervy.example.com

# --- Password reset (entirely optional) -----------------------------------
# Leave the host unset and POST /auth/forgot-password still answers 202
# (never disclosing whether an address is registered) but sends no mail.
# KERVY_PLATFORM_SMTP_HOST=
# KERVY_PLATFORM_SMTP_PORT=587
# KERVY_PLATFORM_SMTP_FROM_ADDRESS=no-reply@kervy.example.com
# KERVY_PLATFORM_SMTP_USERNAME=
# KERVY_PLATFORM_SMTP_PASSWORD_ENV_VAR=KERVY_PLATFORM_SMTP_PASSWORD
# KERVY_PLATFORM_SMTP_PASSWORD=
# KERVY_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
