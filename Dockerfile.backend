# syntax=docker/dockerfile:1
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Picks up Debian security patches (e.g. libpcre2) released after this image
# was last baked, so the container scan doesn't flag a fix that already
# exists upstream — the base image's own packages, not anything this
# project pins itself.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/pyproject.toml backend/constraints.lock.txt ./
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./

# -c pins every transitive dependency to backend/uv.lock's resolved version
# (regenerate both via `python -m scripts.relock`, backend/scripts/relock.py)
# rather than whatever `>=` in pyproject.toml happens to resolve to today —
# the same drift class that produced several of this repo's own past
# dedicated "fix CI" PRs.
RUN pip install --no-cache-dir -c constraints.lock.txt . \
    && useradd --create-home --uid 1000 appuser \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
